NODE_ENV=development
PORT=3001
# Conexão de dono das tabelas — só para `pnpm db:migrate` / `db:generate`.
DATABASE_URL=postgres://pcaarb:pcaarb@localhost:5433/pcaarb
# Conexão de runtime da API — role restrita, sem SUPERUSER/BYPASSRLS, criada
# pela migration 0011_app_role_least_privilege. É a que faz RLS valer de verdade.
APP_DATABASE_URL=postgres://pcaarb_app:pcaarb_app@localhost:5433/pcaarb
JWT_ACCESS_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_REFRESH_SECRET=troque-por-outro-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
TRIAL_DAYS=14
CORS_ORIGIN=http://localhost:3000
# Convite de usuário por e-mail (resend.com). Sem domínio verificado,
# onboarding@resend.dev só entrega para o e-mail da sua própria conta Resend.
RESEND_API_KEY=re_troque-pela-sua-api-key
RESEND_FROM_EMAIL=onboarding@resend.dev
